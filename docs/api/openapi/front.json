{
    "openapi": "3.0.0",
    "info": {
        "title": "Afendar API",
        "description": "API for Afendar Games projects",
        "version": "1.0.0"
    },
    "paths": {
        "/api/issues/{id}": {
            "get": {
                "tags": [
                    "Issues"
                ],
                "operationId": "get_issuelist",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "\\d+"
                        }
                    }
                ],
                "responses": {
                    "default": {
                        "description": ""
                    }
                }
            }
        },
