                "operationId": "get_previewget",
                "parameters": [
                    {
                        "name": "token",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "[a-f0-9]{64}"
                        }
                    }
                ],
                "responses": {
                    "default": {
                        "description": ""
                    }
